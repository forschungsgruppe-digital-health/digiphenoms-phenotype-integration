# DigiPhenoMS Docker Compose Environment
# Copy to .env and adjust as needed.

# PostgreSQL
DB_NAME=hapi
DB_USER=hapi
DB_PASSWORD=hapi

# FHIR Server (exposed port on host)
FHIR_PORT=8080

# FHIR Server port inside the container (also used for the healthcheck
# and as default port in FHIR_BASE_URL / FHIR_SERVER_ADDRESS)
SERVER_PORT=8080

# Public base URL written into FHIR responses — set when running behind
# a reverse proxy (default: http://localhost:<SERVER_PORT>/fhir)
#FHIR_SERVER_ADDRESS=https://fhir.example.org/fhir

# Database (external access port on host)
DB_PORT=5432

# PostgreSQL host the FHIR server connects to — point at an external
# database instead of the bundled db service if needed (in-network port
# of the bundled service is always 5432)
#DB_HOST=db

# Pipeline — path to directory with CSV input files
DATA_DIR=./data

# Target endpoint for $cohort-submit from the pipeline container
# (default: the bundled fhir-server service)
#FHIR_BASE_URL=http://fhir-server:8080/fhir

# ML server (synthetic data jobs) — reached through SSH port forwarding on
# the Docker host (see docs/ml_server_api.md):
#   ssh -L 8000:localhost:8000 "$ML_SERVER_SSH_USER@$ML_SERVER_SSH_HOST" -N
# From inside the containers the host tunnel is host.docker.internal.
ML_SERVER_URL=http://host.docker.internal:8000
# SSH user and host for the tunnel (ask the ML team; do NOT commit)
ML_SERVER_SSH_USER=
ML_SERVER_SSH_HOST=
# Per-request timeout in seconds for ML server calls
ML_SERVER_TIMEOUT=60
# Bearer token for the ML server API (ask the ML team; do NOT commit)
API_AUTH_TOKEN=
